# CPSM server production configuration
# Keep this file mode 0600. The values below are host-local test credentials.
PORT=18732
CPSM_SERVER_HOST=127.0.0.1
CPSM_SERVER_DATA_DIR=/home/ubuntu/web-service/cpsm-server/data
CPSM_ARTIFACTS_DIR=/home/ubuntu/web-service/cpsm-server/artifacts
CPSM_AUTH_MODE=strict
CPSM_DISABLE_FCM=1
CPSM_DEVICE_AUTH_MAX_AGE_MS=300000
CPSM_DEVICE_NONCE_TTL_MS=300000
